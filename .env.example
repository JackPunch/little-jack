# openai or anthropic
LLM_FORMAT=openai

# Debug mode: true / 1 / yes / on
# LLM_DEBUG=true

# ─── OpenAI format example ───
LLM_BASE_URL=api.openai.com/v1
LLM_MODEL_NAME=o3-mini
LLM_API_KEY=sk-xxxxxxxx

# ─── Anthropic format example ───
# LLM_FORMAT=anthropic
# LLM_BASE_URL=api.anthropic.com/v1
# LLM_MODEL_NAME=claude-3-7-sonnet-20250219
# LLM_API_KEY=sk-ant-api03-xxxxxxxx

# ─── Thinking controls (applies to both OpenAI & Anthropic) ───
# Thinking mode switch: enabled / disabled (enabled by default)
# LLM_THINKING_TYPE=disabled

# Thinking intensity (options: high / max):
# LLM_REASONING_EFFORT=high

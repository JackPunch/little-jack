# openai or anthropic
LLM_FORMAT=openai

# ─── OpenAI format example ───
LLM_BASE_URL=api.openai.com/v1
LLM_MODEL_NAME=o3-mini
LLM_API_KEY=sk-xxxxxxxx

# OpenAI thinking controls:
# LLM_THINKING_TYPE=enabled        -> requests body: thinking.type
# LLM_REASONING_EFFORT=high        -> requests body: reasoning_effort

# ─── Anthropic format example ───
# LLM_FORMAT=anthropic
# LLM_BASE_URL=api.anthropic.com/v1
# LLM_MODEL_NAME=claude-3-7-sonnet-20250219
# LLM_API_KEY=sk-ant-api03-xxxxxxxx

# Anthropic thinking controls:
# LLM_THINKING_TYPE=enabled        -> requests body: thinking.type
# LLM_REASONING_EFFORT=high        -> requests body: output_config.effort

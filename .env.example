# Debug mode: true
# DEBUG=true

# Stream mode: true
# STREAM=true

# Tool calling mode: true
# When enabled, the agent can call tools (e.g. ask_user).
# Note: tool calling forces non-streaming mode.
# TOOLS=true

# ─── OpenAI format example ───
BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
API_KEY=sk-xxxxxxxx

# ─── Thinking controls ───
# Thinking mode switch: enabled / disabled (enabled by default)
# THINKING_TYPE=disabled

# Thinking intensity (options: high / max, default: high):
# REASONING_EFFORT=max

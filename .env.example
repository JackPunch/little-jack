# Debug mode: true / 1 / yes / on
# LLM_DEBUG=true

# Stream mode: true / 1 / yes / on
# LLM_STREAM=true

# Tool calling mode: true / 1 / yes / on
# When enabled, the agent can call tools (e.g. ask_user).
# Note: tool calling forces non-streaming mode.
# LLM_TOOLS=true

# ─── OpenAI format example ───
LLM_BASE_URL=api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash
LLM_API_KEY=sk-xxxxxxxx

# ─── Thinking controls ───
# Thinking mode switch: enabled / disabled (enabled by default)
# LLM_THINKING_TYPE=disabled

# Thinking intensity (options: high / max, default: high):
# LLM_REASONING_EFFORT=max
